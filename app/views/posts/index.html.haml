- content_for :title, 'Blog'
.mx-auto.max-w-6xl.px-6.py-16
  %h1.text-4xl.font-semibold.tracking-tight Blog
  %p.mt-3.text-stone-400 Actualités, réalisations et conseils

  - if @posts.empty?
    %p.mt-16.text-center.text-stone-500 Aucun article pour le moment.
  - else
    .mt-12.grid.gap-8.sm:grid-cols-2.lg:grip-cols-3
      - @posts.each do |post|
        = link_to post_path(post.slug), class: "group block overflow-hidden rounded-xl border border-stone-800 bg-stone-900 transition hover:border-stone-600" do
          - if post.cover.attached?
            = image_tag post.cover, class: "h-48 w-full object-cover transition group-hover:scale-105"
          - else
            .h-48.w-full.bg-stone-800

          .p-5
            %time.text-xs.uppercase.tracking-wide.text-stone-500= l(post.published_at.to_date, format: :long)
            %h2.mt-2.text-lg.font-semibold= post.title
            %p.mt-2.line-clamp-3.text-sm.text-stone-400= post.excerpt