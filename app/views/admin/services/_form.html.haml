= form_with model: [:admin, service], class: "space-y-4 max-w-2xl" do |f|
  = render "admin/shared/errors", record: service

  .form-control
    = f.label :name, "Nom", class: "label"
    = f.text_field :name, class: "input input-bordered w-full"

  .form-control
    = f.label :description, "Description", class: "label"
    = f.text_area :description, rows: 3, class: "textarea textarea-bordered w-full"

  .grid.gap-4.sm:grid-cols-3
    .form-control
      = f.label :duration_minutes, "Durée (minutes)", class: "label"
      = f.number_field :duration_minutes, min: 5, step: 5, class: "input input-bordered w-full"
    .form-control
      = f.label :price_euros, "Prix (€)", class: "label"
      = f.number_field :price_euros, min: 0, step: 0.01, value: service.price_euros,
        class: "input input-bordered w-full"
    .form-control
      = f.label :deposit_euros, "Acompte (€)", class: "label"
      = f.number_field :deposit_euros, min: 0, step: 0.01, value: service.deposit_euros,
        class: "input input-bordered w-full"
    = f.number_field :position, min: 0, class: "hidden"

  .form-control
    %label.label.cursor-pointer.justify-start.gap-3
      = f.check_box :active, class: "toggle toggle-primary"
      %span.label-text Active (proposée à la réservation)

  .flex.gap-2.pt-2
    = f.submit "Enregistrer le service", class: "btn btn-primary"
    = link_to "Annuler", admin_services_path, class: "btn btn-ghost"