- content_for :page_title, "Rendez-vous"

.tabs.tabs-box.mb-6.w-fit
  = link_to "Tous", admin_appointments_path, class: ['tab', ("tab-active" if params[:status].blank?)]
  - Appointment.aasm.states.map(&:name).each do |status|
    = link_to AdminHelper::STATUS_LABELS[status], admin_appointments_path(status: status), class: ['tab', ('tab-active' if params[:status]&.to_sym == status)]

.card.bg-basqe-100.shadow-sm
  .overflow-x-auto
    %table.table
      %thead
        %tr
          %th Date
          %th Client
          %th Prestation
          %th Status
          %th
      %tbody
        - @appointments.each do |appointment|
          %tr.hover
            %td.whitespace-nowrap= l(appointment.starts_at, format: :long)
            %td
              .font-medium = appointment.client_name
              .text-xs.opacity-60= appointment.client_email
            %td= appointment.service.name
            %td= status_badge(appointment.status)
            %td.text-right= link_to 'Détail', admin_appointment_path(appointment), class: 'btn btn-ghost btn-xs'
        - if @appointments.empty?
          %tr
            %td.text-center.opacity-60{colspan: 5} Aucun rendez-vous.
