= form_with model: [:admin, appointment], class: "space-y-4 max-w-2xl" do |f|
  = render "admin/shared/errors", record: appointment

  .form-control
    = f.label :client_id, "Client", class: "label"
    = f.collection_select :client_id, @clients, :id, :full_name,
      { prompt: "Choisir un client" }, class: "select select-bordered w-full"
    %span.label-text-alt.mt-1
      = link_to "Créer un nouveau client", new_admin_client_path, class: "link"

  .form-control
    = f.label :service_id, "Prestation", class: "label"
    = f.collection_select :service_id, @services, :id,
      ->(s) { "#{s.name} (#{s.duration_minutes} min)" }, {},
      class: "select select-bordered w-full"

  .form-control
    = f.label :starts_at, "Date et heure", class: "label"
    = f.datetime_local_field :starts_at, class: "input input-bordered w-full"

  .form-control
    = f.label :client_notes, "Notes", class: "label"
    = f.text_area :client_notes, rows: 4, class: "textarea textarea-bordered w-full"

  - if appointment.persisted?
    .form-control
      = f.label :status, "Statut", class: "label"
      = f.select :status, %w[pending_payment confirmed cancelled expired].map { |s| [t("appointments.statuses.#{s}"), s] }, {},
        class: "select select-bordered w-full"

  .flex.gap-2.pt-2
    = f.submit "Créer le rendez-vous", class: "btn btn-primary"
    = link_to "Annuler", admin_appointments_path, class: "btn btn-ghost"