- content_for :title, "Accueil"
%section{class: "mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-6 text-center"}
  %span{class: "mb-6 inline-block rounded-full border border-amber-500/40 px-4 py-1 text-xs uppercase tracking-widest text-amber-400"}
    En construction
  %h1.text-4xl.font-semibold.tracking-tight.sm:text-6xl
    Le site arrive bientôt
