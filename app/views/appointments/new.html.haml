-# app/views/appointments/new.html.haml
.max-w-2xl.mx-auto.px-4.py-12
  %h1.text-3xl.font-semibold.mb-2= "Réserver : #{@service.name}"
  %p.text-gray-600.mb-8
    = "Durée #{@service.duration_minutes} min · Acompte #{number_to_currency(@service.deposit_cents / 100.0, unit: '€', format: '%n %u')}"

  = form_with model: @appointment, url: appointments_path, class: "space-y-6" do |f|
    = f.hidden_field :service_id, value: @service.id

    - if @appointment.errors.any?
      .rounded.bg-red-50.p-4.text-red-700.text-sm
        %ul
          - @appointment.errors.full_messages.each do |msg|
            %li= msg

    %div{ data: { controller: "slot-picker", slot_picker_url_value: slots_appointments_path(service_id: @service.id) } }
      %label.block.text-sm.font-medium.mb-1{ for: "date" } Choisissez un jour
      = date_field_tag :date, nil, id: "date", min: Date.current.to_s,
        class: "w-full rounded border-gray-300", data: { action: "change->slot-picker#load" }

      = turbo_frame_tag "slots", class: "block mt-4" do
        %p.text-sm.text-gray-500 Sélectionnez une date pour voir les créneaux.

    .grid.gap-4.sm:grid-cols-2
      %div
        = f.label :client_name, "Nom", class: "block text-sm font-medium mb-1"
        = f.text_field :client_name, required: true, class: "w-full rounded border-gray-300"
      %div
        = f.label :client_phone, "Téléphone", class: "block text-sm font-medium mb-1"
        = f.telephone_field :client_phone, required: true, class: "w-full rounded border-gray-300"

    %div
      = f.label :client_email, "Email", class: "block text-sm font-medium mb-1"
      = f.email_field :client_email, required: true, class: "w-full rounded border-gray-300"

    %div
      = f.label :client_notes, "Votre projet (zone du corps, taille approximative, idée...)", class: "block text-sm font-medium mb-1"
      = f.text_area :client_notes, rows: 4, class: "w-full rounded border-gray-300"

    = f.submit "Confirmer la demande", class: "w-full rounded bg-black text-white py-3 hover:bg-gray-800 cursor-pointer"